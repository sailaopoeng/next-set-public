# Supabase public connection settings (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only key. Required for guest reads and admin operations. Never publish.
SUPABASE_SERVICE_ROLE_KEY=""

# REQUIRED: one exact Google account email, e.g. owner@example.com.
# Blank/unset denies owner access. This restricts editing, not guest viewing.
ALLOWED_EMAIL=""

# Server-only; leave blank to use deterministic review/replacement fallback.
# The ad-hoc AI coach requires a working Gemini key.
GEMINI_API_KEY=""
# Review, weekly analysis, and exercise replacement agents.
GEMINI_MODEL="gemini-3.1-flash-lite"
# Workout coach agent.
GEMINI_COACH_MODEL="gemini-3.5-flash"
